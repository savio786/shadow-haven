{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadow-haven",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Static frontend (public/) is served directly by Workers Static Assets.
  // Requests that don't match a file fall through to the Worker (API + WebSockets).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Workers AI gives bots their voices in meetings. Without it (or when the
  // daily allowance is used up) bots fall back to evidence-based lines.
  "ai": { "binding": "AI" },

  // Per-address limits (approximate, per Cloudflare location): creating rooms,
  // and connecting to / looking up rooms (which also slows down code guessing).
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "8101", "simple": { "limit": 12, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "8102", "simple": { "limit": 90, "period": 60 } }
  ],

  // One Durable Object instance per game room, addressed by room code.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Lives on your existing Cloudflare zone. Cloudflare creates the DNS record
  // and certificate for this hostname on first deploy.
  "routes": [
    { "pattern": "game2.sedigitaltransformation.com", "custom_domain": true }
  ],

  // Keep the *.workers.dev URL too — handy for testing.
  "workers_dev": true
}
