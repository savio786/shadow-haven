{
  "name": "shadow-haven",
  "version": "1.1.0",
  "private": true,
  "description": "Shadow Haven \u2014 a multiplayer social-deduction game of Lantern Keepers and hidden Shades.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "dev:test": "wrangler dev --local --var RATE_LIMITS:off --var DEBUG_STATS:on",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "test": "node test/run.mjs",
    "test:soak": "node test/soak.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.155.0"
  }
}
